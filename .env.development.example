# 复制为 .env 或 .env.development

# 推荐：线上 API（固定 https://dnhyxc.cn:9112/api）
VITE_API_BASE_URL=https://dnhyxc.cn:9112/api
# 与 Web apps/frontend/.env 保持一致
VITE_MD5_KEY=your-md5-key
VITE_MD5_IV_KEY=your-md5-iv-key

# 本地后端（仅当 dnhyxc-ai 已合并 wechat 路由时使用；当前默认分支无此接口）
# VITE_API_BASE_URL=http://localhost:9226/api
